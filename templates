<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="static/style.css">
    <title>Predictor</title>
</head>

<body>
    <div class="wrapper">
        <div class="title">
            Flight Price Predictor
        </div>

        <form action="/" method="post">
            <div class="inputfield">
                <label for="source">Source</label>
                <div class="custom_select">
                    <select name="source" id="source">
                        <option values="" selected hidden>Select</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Kolkata">Kolkata</option>
                        <option value="Mumbai">Mumbai</option>
                        <option value="Chennai">Chennai</option>
                        <option value="Bangalore">Bangalore</option>
                        <option value="Hydabad">Hydabad</option>
                    </select>
                </div>
            </div>
            <div class="inputfield">
                <label for="destination">Destination</label>
                <div class="custom_select">
                    <select name="destination" id="destination">
                        <option values="" selected hidden>Select</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Kolkata">Kolkata</option>
                        <option value="Mumbai">Mumbai</option>
                        <option value="Chennai">Chennai</option>
                        <option value="Bangalore">Bangalore</option>
                        <option value="Hydabad">Hydabad</option>
                    </select>
                </div>
            </div>
            <div class="inputfield">
                <label for="airline">Airline</label>
                <div class="custom_select">
                    <select name="airline" id="airline">
                        <option values="" selected hidden>Select</option>
                        <option value="AirAsia">AirAsia</option>
                        <option value="Air_India">Air_India</option>
                        <option value="G0_FIRST">G0_FIRST</option>
                        <option value="SpiceJet">SpiceJet</option>
                        <option value="Indigo">Indigo</option>
                        <option value="Vistara">Vistara</option>
                    </select>
                </div>
            </div>
            <div class="inputfield">
                <label for="class">Class(Business_class:1 | Economy_class:0)</label>
                <input type="text" class="input" name="class" required>
            </div>
            <div class="inputfield">
                <label for="departure">Departure_time</label>
                <div class="custom_select">
                    <select name="departure" id="departure">
                        <option values="" selected hidden>Select</option>
                        <option value="Early_morning">Early_morning</option>
                        <option value="Morning">Morning</option>
                        <option value="Evening">Evening</option>
                        <option value="Afternoon">Afternoon</option>
                        <option value="Night">Night</option>
                        <option value="Late_night">Late_night</option>
                    </select>
                </div>
            </div>
            <div class="inputfield">
                <label for="arrival">Arrival_time</label>
                <div class="custom_select">
                    <select name="arrival" id="arrival">
                        <option values="" selected hidden>Select</option>
                        <option value="Early_morning">Early_morning</option>
                        <option value="Morning">Morning</option>
                        <option value="Evening">Evening</option>
                        <option value="Afternoon">Afternoon</option>
                        <option value="Night">Night</option>
                        <option value="Late_night">Late_night</option>
                    </select>
                </div>
            </div>
            <div class="inputfield">
                <label for="duration">Duration</label>
                <input type="text" class="input" name="duration" required>
            </div>
            <div class="inputfield">
                <label for="stops">Stops</label>
                <input type="text" class="input" name="stops" required>
            </div>
            <div class="inputfield">
                <label for="days_left">Days_left</label>
                <input type="text" class="input" name="days_left" required>
            </div>
            <div class="inputfield">
                <input type="submit" class="btn" value="Predict Price">
            </div>
        </form>
        <div class="result">
            {% if pred != 0 %}
            <p>
                Estimated price: INR {{ pred }}
            </p>
            {% endif %}
        </div>
    </div>
</body>

</html>
